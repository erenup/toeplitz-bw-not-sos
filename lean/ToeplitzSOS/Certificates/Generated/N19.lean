/-- A kernel-checked SOS certificate for the residual Hpoly at m = 18. -/
theorem Hpoly_isSumSq_n19 : IsSumSqHomQuad (ThmA.Hpoly 18) := by
  have hgram : ThmA.Hpoly 18 =
