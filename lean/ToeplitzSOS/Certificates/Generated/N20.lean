  MvPolynomial.C (6 : ℝ) * (Certificates.hWedge (12 : Fin 19) (18 : Fin 19)) * (Certificates.hWedge (12 : Fin 19) (18 : Fin 19)) +
  MvPolynomial.C (10 : ℝ) * (Certificates.hWedge (13 : Fin 19) (17 : Fin 19)) * (Certificates.hWedge (13 : Fin 19) (17 : Fin 19)) +
  MvPolynomial.C (-2 : ℝ) * (Certificates.hWedge (13 : Fin 19) (17 : Fin 19)) * (Certificates.hWedge (14 : Fin 19) (18 : Fin 19)) +
  MvPolynomial.C (4 : ℝ) * (Certificates.hWedge (14 : Fin 19) (18 : Fin 19)) * (Certificates.hWedge (14 : Fin 19) (18 : Fin 19))

private theorem hBase_eq_gram :
    hBaseBlock0 + hBaseBlock1 = hGramBlock0 + hGramBlock1 := by
  simp [hBaseBlock0, hBaseBlock1, hGramBlock0, hGramBlock1, Certificates.hWedge]
  polynomial

/-- A kernel-checked SOS certificate for the residual Hpoly at m = 19. -/
theorem Hpoly_isSumSq_n20 : IsSumSqHomQuad (ThmA.Hpoly 19) := by
  have hgram : ThmA.Hpoly 19 =
      hBaseBlock0 +
      hBaseBlock1 := by
    simp (config := { maxSteps := 1000000 })
      [Int.Icc_eq_finset_map, Int.Ioc_eq_finset_map,
      Int.Ico_eq_finset_map, Finset.sum_map, Finset.sum_range_succ,
      ThmA.Hpoly, ThmA.Hform, ThmA.hv, ThmA.wedge,
      hBaseBlock0, hBaseBlock1, Certificates.hWedge]
    polynomial
  rw [hgram]
  rw [hBase_eq_gram]
  exact (hGramBlock0_sos).add hGramBlock1_sos

/-- The residual-form decomposition lifts the checked Hpoly certificate to the original quartic. -/
theorem toeplitzBW_isSumSq_n20 :
    IsSumSqHomQuad (toeplitzBW 20) :=
  ThmA.isSumSqHomQuad_of_Hpoly 20 (by omega) Hpoly_isSumSq_n20

end

