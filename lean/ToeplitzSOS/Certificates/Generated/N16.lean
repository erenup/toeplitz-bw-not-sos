private theorem hBase_eq_gram :
    hBaseBlock0 + hBaseBlock1 = hGramBlock0 + hGramBlock1 := by
  simp [hBaseBlock0, hBaseBlock1, hGramBlock0, hGramBlock1, Certificates.hWedge]
  polynomial

/-- A kernel-checked SOS certificate for the residual Hpoly at m = 15. -/
theorem Hpoly_isSumSq_n16 : IsSumSqHomQuad (ThmA.Hpoly 15) := by
  have hgram : ThmA.Hpoly 15 =
      hBaseBlock0 +
      hBaseBlock1 := by
    simp (config := { maxSteps := 1000000 })
      [Int.Icc_eq_finset_map, Int.Ioc_eq_finset_map,
      Int.Ico_eq_finset_map, Finset.sum_map, Finset.sum_range_succ,
      ThmA.Hpoly, ThmA.Hform, ThmA.hv, ThmA.wedge,
      hBaseBlock0, hBaseBlock1, Certificates.hWedge]
    polynomial
  rw [hgram]
  rw [hBase_eq_gram]
  exact (hGramBlock0_sos).add hGramBlock1_sos

/-- The residual-form decomposition lifts the checked Hpoly certificate to the original quartic. -/
theorem toeplitzBW_isSumSq_n16 :
    IsSumSqHomQuad (toeplitzBW 16) :=
  ThmA.isSumSqHomQuad_of_Hpoly 16 (by omega) Hpoly_isSumSq_n16

